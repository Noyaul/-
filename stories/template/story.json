  "narrative": {
    "characters": [
      {
        "id": "lead-1",
        "name": "SHOTARO",
        "avatar": "",
        "bio": "Saki 独立咖啡店合伙人、店长，27岁（暂定）。与主控认识约8个月，是熟客与店长。亲切温柔，记得主控常点的饮品和栗子的名字；喜欢分享咖啡、天气与店铺日常，常用表情包，偶尔发送语音。攻略关键词：温柔、主动、细节、偏爱。Saki 有两层，一楼为咖啡操作区和吧台，二楼有靠窗座位；定期更换播放列表并售卖少量咖啡豆与周边。",
        "revealAtChapterId": "shared-1"
      },
      {
        "id": "lead-2",
        "name": "EUNSEOK",
        "avatar": "",
        "bio": "同公司战略企划部职员，28岁（暂定），与主控认识约1年，是跨部门同事。工作讲效率，不喜欢无效沟通；话少、冷幽默、擅长吐槽，关心别人时通常语气平常。养有马尔济斯查理。与主控因项目合作熟悉，之后逐渐发展出工作外聊天。特殊支线「狗狗家长临时联络处」必须是主控与 Eunseok 的 KakaoTalk 双人私人聊天，不设置群聊。攻略关键词：吐槽、边界感、默默关心。",
        "revealAtChapterId": "shared-1"
      },
      {
        "id": "lead-3",
        "name": "SUNGCHAN",
        "avatar": "",
        "bio": "广告公司项目负责人，27岁（暂定），与主控认识约3个月，是品牌项目合作方对接人。阳光、热情、直球，擅长沟通，喜欢足球和健身；消息积极，常发语音、运动与日常照片，会主动询问周末安排。养有马尔济斯冬天。与主控从项目会议和工作沟通逐渐发展出私人话题。攻略关键词：直球、热情、主动、胜负欲。与 Eunseok 因品牌项目相识，两人的主动与克制形成对照。",
        "revealAtChapterId": "shared-1"
      },
      {
        "id": "lead-4",
        "name": "WONBIN",
        "avatar": "",
        "bio": "视觉设计公司职员，26岁（暂定），喜欢摄影、逛展与音乐，常拍城市街景、建筑、光影和生活细节。是主控前男友的朋友，两年前在朋友聚会上见过主控，当时因她有恋人而尊重边界，没有越界。故事开始前约一个月，两人在小区公园重逢；他以相机镜头盖掉落为契机自然搭话，之后发现彼此住在同一小区。前期克制、少主动发消息，喜欢用照片表达；隐藏信息：他曾留意主控的遛狗时间以确认她是否仍住附近，不能在故事前期揭露。攻略关键词：多年暗恋、克制、试探、占有欲。路线核心是重新认识现在的主控，而非干涉她过去的恋情。",
        "revealAtChapterId": "shared-2"
      },
      {
        "id": "lead-5",
        "name": "SOHEE",
        "avatar": "",
        "bio": "品牌宣传部门实习生，24岁（暂定），已成年大学毕业生，与主控认识约2周，是同部门前后辈。活泼、直率、分享欲强，喜欢唱歌和音乐；常连续发送多条消息、使用可爱表情和贴图，喜欢得到主控肯定，也会用玩笑试探态度。工作上经验不足但学习能力好。实习期结束并进入正式工作阶段后，才进入平等的正式攻略阶段。攻略关键词：活泼、直率、分享欲、反差、依赖感。",
        "revealAtChapterId": "shared-1"
      },
      {
        "id": "lead-6",
        "name": "ANTON",
        "avatar": "",
        "bio": "音乐专业大学毕业生、音乐工作室助理，23岁（暂定），是主控好友的亲弟弟，从小认识但并不熟悉。安静、感性、细腻，喜欢作曲、钢琴、游泳和听音乐；通过歌曲链接、音乐作品和日常照片表达自己，回复不一定快但内容认真，不喜欢被当成小孩子。对主控有自己的坚持，会主动提出真正意义上的约会。攻略关键词：青涩年下、精神共鸣、安静、细腻、慢热。",
        "revealAtChapterId": "shared-1"
      }
    ],
    "sharedChapters": [
      {
        "id": "shared-1",
        "title": "日常的裂隙",
        "summary": "时间：8月上旬。建立主控在首尔的工作、生活、居住环境与手机系统；Shotaro、Eunseok、Sungchan 已在主控生活中，Sohee 正式入职，Anton 通过好友聚会重新进入日常。Wonbin 尚未正式出现在联系人列表中。",
        "order": 1,
        "prerequisites": []
      },
      {
        "id": "shared-2",
        "title": "偶然发生之前",
        "summary": "时间：8月中旬。Wonbin 在公园摄影时与正在遛栗子的主控重逢；通过栗子重新建立联系，并意外发现住在同一小区，随后解锁 Wonbin 的 KakaoTalk。",
        "order": 2,
        "prerequisites": []
      },
      {
        "id": "shared-3",
        "title": "季节交替的时候",
        "summary": "时间：8月下旬。六位男主全部解锁；查理、冬天与栗子开始产生交集；Saki 成为重要公共场景；逐渐揭露六人之间的共同好友关系。玩家开始自由选择聊天和约会，各人物好感度系统从此正式展开。",
        "order": 3,
        "prerequisites": []
      },
      {
        "id": "shared-4",
        "title": "被记住的日期",
        "summary": "9月4日生日特殊章节。六位男主都知道主控生日，并以各自方式祝福；出现六人关系交织的特殊事件。玩家选择生日当天最想见的人，不同好感度、此前聊天记录与选择影响礼物、隐藏剧情及特殊群像事件。",
        "order": 4,
        "prerequisites": []
      },
      {
        "id": "shared-5",
        "title": "雨季没有预告",
        "summary": "时间：9月上旬。六人之间开始察觉彼此与主控的关系；Wonbin 两年前的暗恋逐渐浮出水面；Sungchan 的主动与 Eunseok 的克制形成对照；Shotaro 意识到关系不再只是熟客与店长；Sohee 与 Anton 争取独立于原有身份的关系。群像剧情与个人路线逐渐交织。",
        "order": 5,
        "prerequisites": []
      },
      {
        "id": "shared-6",
        "title": "灯火尚未熄灭",
        "summary": "时间：9月中下旬。各角色进入独立攻略分支，玩家做出关系选择；根据前期行为、角色专属条件与隐藏事件，决定个人 HE、BE、隐藏结局或群像特殊结局是否可达。",
        "order": 6,
        "prerequisites": []
      }
    ],
